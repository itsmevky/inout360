{
  "info": {
    "name": "InOut360 Added Endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "QR",
      "item": [
        {
          "name": "Generate QR",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/qr/generate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"login\",\n  \"location\": \"Gate-1\",\n  \"expiresIn\": 300\n}"
            }
          }
        },
        {
          "name": "Generate QR PNG",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "image/png" }
            ],
            "url": "{{base_url}}/qr/generate-png",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"login\",\n  \"location\": \"Gate-1\",\n  \"expiresIn\": 300\n}"
            }
          }
        },
        {
          "name": "Consume QR",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/qr/consume",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{qr_token}}\",\n  \"userId\": \"{{employee_id}}\",\n  \"deviceId\": \"DEV-777\",\n  \"location\": \"Gate-1\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Device",
      "item": [
        {
          "name": "Register Device",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/device/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ravi Kumar\",\n  \"employeeId\": \"EMP-104\",\n  \"deviceId\": \"DEV-777\"\n}"
            }
          }
        },
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/device/send-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{employee_id}}\",\n  \"deviceId\": \"DEV-777\"\n}"
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-device-id", "value": "DEV-777" }
            ],
            "url": "{{base_url}}/device/verify-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otpTransactionId\": \"{{otp_txn_id}}\",\n  \"otp\": \"123456\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/user/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ravi Kumar\",\n  \"employeeId\": \"EMP-104\",\n  \"deviceId\": \"DEV-777\",\n  \"email\": \"ravi104@example.com\",\n  \"password\": \"Passw0rd!\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ravi104@example.com\",\n  \"password\": \"Passw0rd!\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/user/logout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": \"EMP-104\",\n  \"deviceId\": \"DEV-777\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Employees (Maintenance)",
      "item": [
        {
          "name": "List Indexes (Public)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/employees/indexes/public"
          }
        },
        {
          "name": "Cleanup Indexes (Public)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/employees/cleanup-indexes/public"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000/api" },
    { "key": "employee_id", "value": "" },
    { "key": "qr_token", "value": "" },
    { "key": "otp_txn_id", "value": "" }
  ]
}
