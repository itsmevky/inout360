    {
      "name": "Auth / User",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/user/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ravi Kumar\",\n  \"employeeId\": \"EMP-104\",\n  \"email\": \"ravi104@example.com\",\n  \"password\": \"Passw0rd!\",\n  \"role\": \"employee\"\n}"
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/user/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ravi104@example.com\",\n  \"password\": \"Passw0rd!\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "QR",
      "item": [
        {
          "name": "Generate QR",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/qr/generate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"login\",\n  \"location\": \"Gate-1\",\n  \"expiresIn\": 300\n}"
            }
          }
        },
        {
          "name": "Generate QR PNG",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "image/png" }
            ],
            "url": "{{base_url}}/qr/generate-png",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"login\",\n  \"location\": \"Gate-1\",\n  \"expiresIn\": 300\n}"
            }
          }
        },
        {
          "name": "Consume QR",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/qr/consume",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{qr_token}}\",\n  \"userId\": \"{{employee_id}}\",\n  \"deviceId\": \"DEV-777\",\n  \"location\": \"Gate-1\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Device",
      "item": [
        {
          "name": "Register Device",
