              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{employee_id}}\",\n  \"deviceId\": \"DEV-777\"\n}"
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-device-id", "value": "DEV-777" }
            ],
            "url": "{{base_url}}/device/verify-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otpTransactionId\": \"{{otp_txn_id}}\",\n  \"otp\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Track Device",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/device/track",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"DEV-777\",\n  \"lat\": 28.61,\n  \"lng\": 77.20\n}"
            }
          }
        },
        {
          "name": "Get Devices",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/device"
          }
        },
        {
          "name": "Get Device By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/device/{{device_id}}"
          }
        }
      ]
